{
  "name": "kip",
  "version": "0.2.15",
  "private": true,
  "type": "module",
  "description": "A quiet, cross-platform desktop assistant built with Electrobun and Pi",
  "scripts": {
    "icons": "bun run scripts/generate-icon-svg.ts && bun run scripts/generate-icons.ts",
    "dev": "bun run icons && bun run build:view && electrobun dev",
    "dev:hmr": "concurrently -k \"vite --port 5173\" \"KIP_DEV_SERVER=1 bun run dev:main\"",
    "dev:main": "electrobun dev --watch",
    "build:view": "vite build && vite build --config vite.plugins.config.ts",
    "build": "bun run typecheck && bun run icons && bun run build:view && electrobun build --env=stable",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\"",
    "seed": "bun run scripts/seed-provider.ts",
    "sync:cookies": "bun run scripts/sync-gemini-cookies.ts",
    "check:cookies": "bun run scripts/sync-gemini-cookies.ts --check"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "diff": "^9.0.0",
    "electrobun": "1.18.1",
    "immer": "^11.2.10",
    "lucide-react": "^1.74.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "1.3.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "rcedit": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9.3",
    "vite": "^7.3.7"
  }
}
